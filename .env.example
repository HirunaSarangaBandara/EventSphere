# Local development uses SQLite by default. For production use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/eventsphere
DATABASE_URL=sqlite:///./eventsphere.db
SECRET_KEY=replace-this-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=120
WAITLIST_HOLD_MINUTES=10
WAITLIST_SWEEP_SECONDS=30
CHECKIN_EARLY_MINUTES=180
CHECKIN_LATE_MINUTES=120
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
CSRF_COOKIE_SECURE=false
